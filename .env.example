# Copy this file to .env and fill in real values.
# Never commit .env — only this .env.example (names, no secrets) is tracked.

# --- Telegram ---
BOT_TOKEN=

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Sessions (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))") ---
SESSION_SECRET=
SUPER_ADMIN_SESSION_SECRET=

# --- Server ---
# Render supplies PORT automatically — usually no need to set it manually.
PORT=3000
# Must be explicitly set to "production" on Render to enable secure (HTTPS-only) session cookies.
NODE_ENV=production

# --- Optional ---
# Only used to print the correct URL in startup logs — the app does not
# otherwise depend on it (URLs used by the panels are derived from the
# incoming request).
APP_URL=https://app.autocore.pl

# Only needed if switching the Telegram bot from long polling to webhook
# mode. Leave both unset to keep the current (default, already-tested)
# long-polling behavior.
# TELEGRAM_WEBHOOK_URL=https://app.autocore.pl
# TELEGRAM_WEBHOOK_SECRET=

# Second, independent bot token for the internal Workshop Media Bot
# (Task 5). Leave unset to keep that feature disabled. Must be a
# DIFFERENT bot/token than BOT_TOKEN above — create a new bot via
# @BotFather for this. Also requires migrations/004_workshop_media_bot.sql
# and at least one row in workshop_telegram_groups (see that file).
# WORKSHOP_BOT_TOKEN=
